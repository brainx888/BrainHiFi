IDD_BH_MSI_VIEWER DIALOGEX 0, 0, 761, 494
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "BrainHifi - MRI + MEG Source Viewer (axial / coronal / sagittal)"
MENU IDR_MENU_BRAINHIFIVIEW
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Anatomical Data (3D Structure):",IDC_STATIC,7,9,103,8

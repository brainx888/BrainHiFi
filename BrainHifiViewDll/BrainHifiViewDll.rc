/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU_BRAINHIFIVIEW MENU
BEGIN
    POPUP "File"
    BEGIN
        MENUITEM "Open",                        ID_FILE_OPEN32771
        MENUITEM "Save",                        ID_FILE_SAVE32772
    END
    POPUP "Edit"
    BEGIN
        MENUITEM "Load Images for segmentation", ID_EDIT_LOADIMAGESFORSEGMENTATION
        MENUITEM "File Image AI Report",        ID_EDIT_FILE
        MENUITEM "File Image Explanation",      ID_EDIT_FILEIMAGEEXPLANATION
    END
    POPUP "View"
    BEGIN
        MENUITEM "Refresh",                     ID_VIEW_REFRESH
    END
    POPUP "Operation"
    BEGIN
        MENUITEM "Check Credential",            ID_OPERATION_CHECKCREDIENTIAL
        MENUITEM "Fal AI SAM",                  ID_OPERATION_FALAISAM
        MENUITEM SEPARATOR
        MENUITEM "Test Meta Model",             ID_OPERATION_TESTMETAMODAL
        MENUITEM "Test Llama...",               ID_OPERATION_TESTLLAMA
    END
END



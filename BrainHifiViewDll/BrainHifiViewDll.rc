    LTEXT           "",IDC_BH_TXT_AXIAL,199,288,52,8
    CONTROL         "",IDC_BH_SLD_CORONAL,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,258,285,190,14
    LTEXT           "",IDC_BH_TXT_CORONAL,450,288,52,8
    CONTROL         "",IDC_BH_SLD_SAGITTAL,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,509,285,190,14
    LTEXT           "",IDC_BH_TXT_SAGITTAL,701,288,52,8
    GROUPBOX        "MEG source overlay",IDC_STATIC,7,303,495,89
    CONTROL         "Show source",IDC_BH_CHK_SHOW_SRC,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,316,60,10
    CONTROL         "Show negative values",IDC_BH_CHK_NEGATIVE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,80,316,90,10
    CONTROL         "Trilinear interpolation",IDC_BH_CHK_TRILINEAR,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,176,316,90,10
    LTEXT           "Item:",IDC_STATIC,290,317,20,8
    COMBOBOX        IDC_BH_CMB_ITEM,312,314,100,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Go to peak",IDC_BH_BTN_GOTO_PEAK,420,313,75,14
    LTEXT           "Time slice:",IDC_STATIC,14,334,40,8
    CONTROL         "",IDC_BH_SLD_TIME,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,56,331,356,14
    LTEXT           "",IDC_BH_TXT_TIME,416,334,80,8
    LTEXT           "Threshold:",IDC_STATIC,14,354,40,8
    CONTROL         "",IDC_BH_SLD_THRESH,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,56,351,150,14
    LTEXT           "",IDC_BH_TXT_THRESH,208,354,70,8
    LTEXT           "Opacity:",IDC_STATIC,284,354,30,8
    CONTROL         "",IDC_BH_SLD_OPACITY,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,316,351,130,14
    LTEXT           "",IDC_BH_TXT_OPACITY,448,354,48,8
    GROUPBOX        "MRI display",IDC_STATIC,509,303,244,72

    CONTROL         "",IDC_BH_SLD_GRAY_HIGH,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,554,331,192,14
    LTEXT           "",IDC_BH_TXT_GRAY,516,348,230,8
